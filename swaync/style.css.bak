:root {
  --border-radius: 14px;
  --cc-bg: transparent; /* Fully transparent background for notification box */
  --widget-background: rgba(0, 0, 0, 0.65);
  --noti-bg-alpha: 0.6;
  --padding: calc(var(--border-radius) / 2);
}

.control-center {
  border-radius: 0;
  background-color: var(--cc-bg);
}

.widgets > .widget {
  background-color: var(--widget-background);
  border-radius: var(--border-radius);
  padding: 5px 10px;
  border-style: none;
}

.control-center-list-placeholder {
  padding: var(--border-radius);
}

/* Tighter vertical spacing on notification groups */
.notification-group {
  border-radius: var(--border-radius);
  padding: 4px;
  background-color: rgba(40, 40, 40, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.07);
}

.notification-row {
  margin: 2px 0;
}

/* Compact notification cards */
.notification {
  padding: 4px 8px;
  border-radius: 10px;
  background-color: rgba(55, 55, 55, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: #ffffff;
}

.notification:hover {
  background-color: rgba(255, 255, 255, 0.15);
}

.notification-default-action {
  margin: 2px;
  padding: 0;
  border-radius: 14px;
}

/* MPRIS player widget wrapper */
.widget.widget-mpris {
  background-color: transparent;
  border-radius: 0;
  padding: 0;
  border-style: none;
}

/* 1. Completely hide and collapse carousel navigation buttons (prev/next) */
.widget-mpris button,
.widget-mpris button image,
.widget-mpris button label {
  min-width: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
  border-style: none;
  opacity: 0;
  -gtk-icon-size: 0;
  color: transparent;
  background-color: transparent;
  background-image: none;
  box-shadow: none;
}

/* 2. Restore and style ONLY the control buttons inside the player card */
.widget-mpris-player button {
  min-width: 32px;
  min-height: 32px;
  padding: 4px;
  margin: 0 4px;
  opacity: 1;
  -gtk-icon-size: 20px;
  color: #ffffff;
  background-color: transparent;
  background-image: none;
  border-style: none;
  box-shadow: none;
}

.widget-mpris-player button image {
  min-width: 20px;
  min-height: 20px;
  opacity: 1;
  -gtk-icon-size: 20px;
  color: #ffffff;
}

.widget-mpris-player button:hover {
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

/* 3. Completely hide and collapse carousel indicator dots */
.widget-mpris carouselindicatordots,
.widget-mpris carouselindicatordots * {
  min-width: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
  border-style: none;
  opacity: 0;
  background-color: transparent;
  background-image: none;
}

/* 4. Style the player card to fill the full width of the space and be flatter */
.widget-mpris-player {
  box-shadow: none;
  border-style: none;
  border-radius: var(--border-radius);
  margin: 0;
  padding: 6px;
  background-color: rgba(46, 46, 46, 0.7);
  min-width: 396px;
}

.widget-mpris-player:only-child {
  margin: 0;
}

/* Limit MPRIS album art size to flatten the widget */
.widget-mpris-album-art {
  border-radius: 8px;
  min-width: 56px;
  min-height: 56px;
}

/* Compact widget spacing */
.widget-dnd,
.widget-title {
  padding: 2px 0;
  color: #ffffff;
}

/* DND switch */
.widget-dnd > switch:checked {
  background-color: #ffffff;
}
.widget-dnd > switch:checked slider {
  background-color: #000000;
}

/* Title clear-all button */
.widget-title > button:hover {
  background-color: #ffffff;
  color: #000000;
}

/* Close button */
.close-button:hover {
  color: #ffffff;
}

/* Summary & body text */
.summary {
  color: #ffffff;
}
.body {
  color: rgba(255, 255, 255, 0.85);
}
.time {
  color: rgba(255, 255, 255, 0.5);
}

/* Smaller notification icons — constrain ALL image types */
.notification-content image,
.notification image,
.image {
  min-width: 18px;
  min-height: 18px;
  margin: 2px 12px 2px 2px;
}

/* ── Compact popup (floating) notifications ── */
.floating-notifications {
  margin: 4px;
}

.floating-notifications .notification {
  padding: 4px 8px;
  border-radius: var(--border-radius);
}

.floating-notifications .notification-default-action {
  margin: 0;
  padding: 2px 4px;
}

/* Shrink popup notification icon */
.floating-notifications .notification-content image {
  min-width: 24px;
  min-height: 24px;
}

/* Shrink close button on popups */
.floating-notifications .close-button {
  min-width: 20px;
  min-height: 20px;
  padding: 1px;
  margin: 2px;
}

/* Tighten body text spacing in popups */
.floating-notifications .body {
  margin-top: 0;
}

.floating-notifications .summary {
  margin: 0;
}