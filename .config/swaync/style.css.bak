/* Black & White Monochrome Theme - Dense Layout */

@define-color noti-border-color white;
@define-color noti-bg black;
@define-color noti-bg-alt #111111;
@define-color noti-bg-hover #222222;
@define-color text-color white;

* {
    font-family: "JetBrains Mono Nerd Font";
    font-weight: bold;
    font-size: 0.85rem;
}

.control-center .notification-row:focus,
.control-center .notification-row:hover {
    opacity: 1;
    background: transparent;
    box-shadow: none;
}

.notification-row {
    outline: none;
    margin: 8px 0;
    padding: 8px;
    background: @noti-bg-hover;
    border-radius: 12px;
}

.control-center-list > row,
.control-center-list > row:focus,
.control-center-list > row:hover {
    background: transparent;
    border: none;
    box-shadow: none;
}

.notification {
    background: @noti-bg;
    padding: 4px 8px;
    border-radius: 8px;
    border: 1px solid @noti-border-color;
    color: @text-color;
    margin: 0;
    box-shadow: none;
}

.notification-default-action {
    margin: 0;
    padding: 0;
    border-radius: 8px;
}

.close-button {
    background: transparent;
    color: white;
    text-shadow: none;
    padding: 0;
    border-radius: 100%;
    margin-top: 2px;
    margin-right: 2px;
    font-size: 0.7rem;
}

.notification-action {
    border: 1px solid #333;
    border-radius: 8px;
    margin: 2px;
    padding: 2px 4px;
}

.notification-default-action:hover,
.notification-action:hover {
    color: @text-color;
    background: @noti-bg-hover;
}

.body-image {
    margin-top: 4px;
    border-radius: 8px;
}

.summary {
    font-size: 0.85rem;
    font-weight: bold;
    color: @text-color;
}

.time {
    font-size: 0.7rem;
    color: #aaaaaa;
}

.body {
    font-size: 0.75rem;
    color: @text-color;
}

.control-center {
    background: @noti-bg;
    border: 1px solid @noti-border-color;
    color: @text-color;
    border-radius: 12px;
    padding: 6px;
}

.widget-title {
    color: @text-color;
    background: transparent;
    padding: 2px 0;
    margin: 0;
    font-size: 0.95rem;
}

.widget-title > button {
    font-size: 0.7rem;
    color: @text-color;
    border-radius: 6px;
    background: transparent;
    border: 1px solid transparent;
    padding: 2px 6px;
}

.widget-title > button:hover {
    background: @noti-bg-hover;
}

.widget-dnd {
    background: transparent;
    padding: 2px 0;
    margin: 0 0 6px 0;
    font-size: 0.85rem;
    color: @text-color;
}

.widget-dnd > switch {
    border-radius: 12px;
    border: none;
    background: transparent;
}

.widget-dnd > switch:checked {
    background: transparent;
}

.widget-dnd > switch slider {
    background: white;
    border-radius: 12px;
    margin: 2px;
}

.widget-mpris {
    color: @text-color;
    background: @noti-bg-alt;
    padding: 4px;
    margin: 0 0 6px 0;
    border-radius: 8px;
    border: 1px solid #333;
}

.widget-buttons-grid {
    background: transparent;
    padding: 0;
    margin: 0 0 6px 0;
}

.widget-buttons-grid > flowbox > flowboxchild > button {
    background: transparent;
    border-radius: 8px;
    color: @text-color;
    border: 1px solid @noti-border-color;
    margin: 2px;
    padding: 4px 10px;
    font-size: 1.2rem;
}

.widget-volume, .widget-backlight {
    background: transparent;
    padding: 0;
    margin: 0 0 6px 0;
    font-size: 1.1rem;
}

.widget-volume scale, .widget-backlight scale {
    margin: 0 8px;
}

.widget-volume trough, .widget-backlight trough {
    min-height: 4px;
    background: #333;
    border-radius: 4px;
}

.widget-volume highlight, .widget-backlight highlight {
    background: white;
    border-radius: 4px;
}

.widget-volume slider, .widget-backlight slider {
    background: white;
    border-radius: 100%;
    min-width: 14px;
    min-height: 14px;
}
