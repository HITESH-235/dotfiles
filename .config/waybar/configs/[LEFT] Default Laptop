// ### DEFAULT Laptop  - Left ### //
{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "top",
"width": 30,
"tooltip": true,
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"position": "left",
"spacing": 8,
"fixed-center": true,
"ipc": true,
"margin-top": 4,
"margin-bottom": 4,
"margin-left": 3,
"margin-right": 0,

"modules-left": [
	"custom/separator#blank",
	"idle_inhibitor",
	"custom/separator#blank",
	"custom/asus_profile",
	"custom/separator#dot-line",
	"hyprland/window",
	"custom/separator#blank",
	"custom/cava_mviz",
	],

"modules-center": [
	"group/app_drawer",
	"group/notify",
	"custom/separator#dot-line",
	"hyprland/workspaces#rw",
	"custom/separator#dot-line",
	"clock",
	"custom/separator#dot-line",
	"custom/weather",
	],

"modules-right": [
	"tray",
	"custom/separator#dot-line",
	"network",
	"custom/separator#dot-line",
	"bluetooth",
	"custom/separator#dot-line",
	"group/laptop",
	"custom/separator#dot-line",
	"group/mobo_drawer",
	"custom/separator#dot-line",  
	"group/audio",
	"custom/separator#dot-line", 
	"group/status",
	],
}
